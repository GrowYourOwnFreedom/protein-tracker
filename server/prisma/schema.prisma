// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum FoodItemType {
  simple
  composite
}

model FoodItem {
  foodItemId String @id @default(uuid())
  name String
  caloriesPer100g Float
  proteinPer100g Float
  foodItemCategoryId String
  type FoodItemType
  userId String
  createdAt DateTime @default(now())  @db.Timestamptz(3)

  foodLogEntries FoodLogEntry[]
}

model Meal {
  mealId String @id @default(uuid())
  name String
  date String
  createdAt DateTime @default(now())  @db.Timestamptz(3)
  userId String

  foodLogEntries FoodLogEntry[]
}

model FoodLogEntry  {
  foodLogEntryId String @id @default(uuid())
  foodItemId String
  name String
  weight Float
  calories Float
  protein Float
  date String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  userId String
  mealId String?

  foodItem  FoodItem @relation(fields:[foodItemId], references:[foodItemId])
  meal Meal? @relation(fields:[mealId], references:[mealId])
}

model Targets{
  userId String @id
  proteinTarget Float
  calorieLimit Float
  updatedAt DateTime @updatedAt  @db.Timestamptz(3)
}
 model User{
  userId String @id @default(uuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sessions Session[]
 }

 model Session {
  sessionId String @id @default(uuid())
  userId String
  tokenHash String @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references:[userId], onDelete:Cascade)
 }
